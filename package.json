{
  "name": "plumbing-commissioning-pwa",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "build:remote": "node scripts/build-remote-client.mjs",
    "test": "pnpm test:schema && playwright test",
    "test:live": "pnpm test:live:api && pnpm test:live:browser",
    "test:live:api": "node --test tests/live/supabase-permissions.test.mjs",
    "test:live:browser": "playwright test --config=playwright.live.config.js",
    "test:live:cleanup": "node scripts/cleanup-live-test-users.mjs",
    "test:schema": "node --test tests/schema/*.test.js",
    "test:iphone": "playwright test --project=iphone-webkit",
    "test:iphone:headed": "playwright test --project=iphone-webkit --headed",
    "test:iphone:ui": "playwright test --project=iphone-webkit --ui"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "esbuild": "^0.28.2"
  }
}
